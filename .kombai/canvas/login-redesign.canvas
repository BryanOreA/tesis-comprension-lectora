      "html": "<main class=\"min-h-screen bg-[var(--bg)] font-[var(--sans)] text-[var(--text)] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"--text:#6b6375; --text-h:#08060d; --bg:#ffffff; --border:#e5e4e7; --accent:#aa3bff; --accent-bg:rgba(170,59,255,0.1); --accent-border:rgba(170,59,255,0.5); --sans:system-ui,'Segoe UI',Roboto,sans-serif;\">\n    <header class=\"mx-auto flex w-full max-w-[1126px] items-center border-b border-[var(--border)] px-7 py-6 sm:px-10 lg:px-12\" data-kid=\"1-1\" data-name=\"header container\">\n        <p class=\"text-[15px] font-semibold tracking-[-0.02em] text-[var(--text-h)] sm:text-[16px]\" data-kid=\"1-1-1\" data-name=\"platform branding text\">\n            Plataforma de Comprensión Lectora\n        </p>\n    </header>\n    <section class=\"mx-auto grid w-full max-w-[1126px] grid-cols-1 px-7 pb-20 pt-14 sm:px-10 sm:pt-20 md:grid-cols-[220px_minmax(0,500px)] md:gap-[82px] md:px-12 md:pt-24\" data-kid=\"1-2\" data-name=\"login section container\">\n        <aside aria-hidden=\"true\" class=\"reading-margin hidden md:flex md:items-start md:justify-center\" data-kid=\"1-2-1\" data-name=\"decorative reading illustration sidebar\">\n            <svg class=\"mt-3 h-[268px] w-[184px]\" data-kid=\"1-2-1-1\" data-name=\"abstract reading page icon\" fill=\"none\" viewbox=\"0 0 184 268\" xmlns=\"http://www.w3.org/2000/svg\">\n                <g stroke=\"#aa3bff\" stroke-linecap=\"round\" stroke-width=\"2\">\n                    <path d=\"M28 27h83M28 40h116M28 53h70M28 80h104M28 93h78M28 106h111M28 133h69M28 146h115M28 159h85M28 186h102M28 199h72M28 212h116M28 239h84\" opacity=\".22\">\n                    </path>\n                    <path d=\"M132 70v44m0-44h19m-19 44h19\" stroke-width=\"2.5\">\n                    </path>\n                </g>\n                <circle cx=\"132\" cy=\"70\" fill=\"#aa3bff\" r=\"3\">\n                </circle>\n            </svg>\n        </aside>\n        <div class=\"w-full max-w-[500px]\" data-kid=\"1-2-2\" data-name=\"login form wrapper\">\n            <div class=\"mb-9 border-b border-[var(--border)] pb-7 sm:mb-10 sm:pb-8\" data-kid=\"1-2-2-1\" data-name=\"login header group\">\n                <h1 class=\"m-0 text-[38px] font-semibold leading-[1.08] tracking-[-0.045em] text-[var(--text-h)] sm:text-[46px]\" data-kid=\"1-2-2-1-1\" data-name=\"login page title\">\n                    Iniciar sesión\n                </h1>\n                <p class=\"mt-4 max-w-[36ch] text-[16px] leading-7 text-[var(--text)] sm:text-[17px]\" data-kid=\"1-2-2-1-2\" data-name=\"login instructions text\">\n                    Accede con tu usuario y contraseña.\n                </p>\n            </div>\n            <form aria-label=\"Iniciar sesión\" class=\"flex flex-col gap-6\" data-kid=\"1-2-2-2\" data-name=\"login form\">\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-2-2-2-1\" data-name=\"username field group\">\n                    <label class=\"text-[14px] font-semibold leading-5 text-[var(--text-h)]\" data-kid=\"1-2-2-2-1-1\" data-name=\"username label\" for=\"username\">\n                        Usuario\n                    </label>\n                    <input autocomplete=\"username\" class=\"h-[54px] w-full rounded-[6px] border border-[var(--border)] bg-white px-4 text-[16px] text-[var(--text-h)] outline-none placeholder:text-[#8a8490] focus:border-[var(--accent)] focus:ring-3 focus:ring-[var(--accent-bg)]\" data-kid=\"1-2-2-2-1-2\" data-name=\"username input field\" id=\"username\" name=\"username\" placeholder=\"Tu usuario\" type=\"text\"/>\n                </div>\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-2-2-2-2\" data-name=\"password field group\">\n                    <label class=\"text-[14px] font-semibold leading-5 text-[var(--text-h)]\" data-kid=\"1-2-2-2-2-1\" data-name=\"password label\" for=\"password\">\n                        Contraseña\n                    </label>\n                    <input autocomplete=\"current-password\" class=\"h-[54px] w-full rounded-[6px] border border-[var(--border)] bg-white px-4 text-[16px] text-[var(--text-h)] outline-none placeholder:text-[#8a8490] focus:border-[var(--accent)] focus:ring-3 focus:ring-[var(--accent-bg)]\" data-kid=\"1-2-2-2-2-2\" data-name=\"password input field\" id=\"password\" name=\"password\" placeholder=\"Tu contraseña\" type=\"password\"/>\n                </div>\n                <div aria-atomic=\"true\" aria-live=\"polite\" class=\"min-h-0\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3\" data-name=\"login error message container\" data-reason=\"error text visibility toggled by form validation script\">\n                    <p class=\"hidden rounded-[4px] border-l-2 border-[#b42345] bg-[#fff5f6] px-3 py-2 text-[14px] font-medium leading-5 text-[#8f1731]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3-1\" data-name=\"login error alert text\" data-reason=\"error message text toggled by form validation script\" role=\"alert\">\n                        Usuario o contraseña incorrectos. Revisa los datos e inténtalo de nuevo.\n                    </p>\n                </div>\n                <button aria-busy=\"false\" class=\"mt-1 flex h-[54px] w-full items-center justify-center rounded-[6px] bg-[#6f21a8] px-5 text-[16px] font-semibold text-white outline-none hover:bg-[#581c87] focus-visible:ring-3 focus-visible:ring-[var(--accent-border)] focus-visible:ring-offset-2 disabled:cursor-wait disabled:bg-[#5f4b70]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-4\" data-name=\"login submit button\" data-reason=\"busy state and label text toggled by script\" type=\"submit\">\n                    <span data-dynamic=\"true\" data-kid=\"1-2-2-2-4-1\" data-name=\"submit button text\" data-reason=\"text replaced by loading state script\">\n                        Iniciar sesión\n                    </span>\n                </button>\n                <p aria-live=\"polite\" class=\"hidden text-[14px] font-medium text-[var(--text-h)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-5\" data-name=\"loading status message\" data-reason=\"visibility toggled by script during form submission\" role=\"status\">\n                    Iniciando sesión…\n                </p>\n            </form>\n        </div>\n    </section>\n    <style>\n        @media (max-width: 767px) {\n      .reading-margin { display: none; }\n    }\n    </style>\n</main>\n",
