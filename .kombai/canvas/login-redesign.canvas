    "var_d83adced245e": {
      "type": "variant",
      "label": "Login — Panel de lectura y acceso",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    .login-design {\n    --ink: #261b30;\n    --muted: #625b68;\n    --paper: #fffdfa;\n    --line: #ded7e4;\n    --brand: #aa3bff;\n    --brand-deep: #4b1d69;\n    --identity-bg: #f0eaf6;\n    --error: #a32020;\n    --error-bg: #fff0ee;\n    min-height: 100svh;\n    display: grid;\n    grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr);\n    color: var(--ink);\n    background: var(--paper);\n    font-family: system-ui, 'Segoe UI', Roboto, sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n  .identity-panel {\n    min-width: 0;\n    min-height: 100svh;\n    background: var(--identity-bg);\n    padding: 64px clamp(36px, 6.1vw, 88px) 48px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n  .reading-diagram {\n    width: min(100%, 570px);\n    align-self: center;\n    overflow: visible;\n  }\n  .identity-note {\n    max-width: 390px;\n    margin: 24px auto 0;\n    align-self: center;\n    color: #51465c;\n    font-size: 16px;\n    line-height: 1.55;\n    letter-spacing: 0.01em;\n  }\n  .identity-mobile-title { display: none; }\n  .access-panel {\n    min-width: 0;\n    min-height: 100svh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 52px clamp(38px, 7vw, 104px);\n  }\n  .access-content { width: 100%; max-width: 452px; }\n  .access-content h1 {\n    margin: 0;\n    color: var(--ink);\n    font-size: clamp(36px, 3.25vw, 46px);\n    font-weight: 650;\n    letter-spacing: -0.045em;\n    line-height: 1.08;\n  }\n  .intro {\n    margin: 17px 0 38px;\n    color: var(--muted);\n    font-size: 17px;\n    line-height: 1.5;\n  }\n  .login-form { display: flex; flex-direction: column; }\n  .field { display: flex; flex-direction: column; gap: 9px; }\n  .field + .field { margin-top: 23px; }\n  .field label {\n    color: var(--ink);\n    font-size: 15px;\n    font-weight: 620;\n    line-height: 1.3;\n  }\n  .field input {\n    width: 100%;\n    min-height: 58px;\n    box-sizing: border-box;\n    padding: 0 17px;\n    border: 1px solid #cfc6d5;\n    border-radius: 8px;\n    background: #fff;\n    color: var(--ink);\n    font: inherit;\n    font-size: 16px;\n    outline: none;\n  }\n  .field input::placeholder { color: #77717d; opacity: 1; }\n  .field input:focus-visible {\n    border-color: #6f2a96;\n    box-shadow: 0 0 0 3px rgb(170 59 255 / 22%);\n  }\n  .state-slot {\n    min-height: 48px;\n    display: flex;\n    align-items: center;\n    padding: 4px 0 0;\n    box-sizing: border-box;\n  }\n  .error-message {\n    margin: 0;\n    padding: 0;\n    color: var(--error);\n    font-size: 15px;\n    line-height: 1.4;\n  }\n  .submit-button {\n    min-height: 58px;\n    width: 100%;\n    border: 0;\n    border-radius: 8px;\n    background: var(--brand-deep);\n    color: #fff;\n    cursor: pointer;\n    font: inherit;\n    font-size: 16px;\n    font-weight: 650;\n    letter-spacing: 0.01em;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .submit-button:hover { background: #3d1758; }\n  .submit-button:focus-visible {\n    outline: 3px solid var(--brand);\n    outline-offset: 3px;\n  }\n  .submit-button:disabled { cursor: wait; background: #684582; color: #fff; }\n  .bottom-rule {\n    width: 40px;\n    height: 3px;\n    margin-top: 36px;\n    background: var(--brand);\n    border-radius: 2px;\n  }\n  @media (max-width: 760px) {\n    .login-design { display: flex; flex-direction: column; min-height: 100svh; }\n    .identity-panel {\n      min-height: 0;\n      flex: 0 0 auto;\n      padding: 18px 24px;\n      flex-direction: row;\n      align-items: center;\n      gap: 14px;\n      border-bottom: 1px solid #e2d9e9;\n    }\n    .reading-diagram { display: none; }\n    .identity-mobile-title {\n      display: block;\n      color: var(--ink);\n      font-size: 16px;\n      font-weight: 670;\n      letter-spacing: -0.02em;\n      line-height: 1.25;\n    }\n    .identity-note { margin: 3px 0 0; font-size: 13px; line-height: 1.35; }\n    .access-panel {\n      min-height: calc(100svh - 86px);\n      align-items: flex-start;\n      padding: 42px 24px 34px;\n      box-sizing: border-box;\n    }\n    .access-content { max-width: 480px; margin: auto 0; }\n    .access-content h1 { font-size: clamp(31px, 8vw, 36px); line-height: 1.1; }\n    .intro { margin: 13px 0 30px; font-size: 16px; }\n    .field + .field { margin-top: 20px; }\n    .field input { min-height: 56px; }\n    .state-slot { min-height: 48px; }\n    .submit-button { min-height: 56px; }\n    .bottom-rule { display: none; }\n  }\n  @media (max-width: 390px) {\n    .identity-panel { padding: 16px 20px; }\n    .access-panel { padding: 34px 20px 28px; }\n    .access-content h1 { font-size: 31px; }\n    .intro { margin-bottom: 27px; }\n  }\n</style>\n<div class=\"login-design\" data-kid=\"1\" data-name=\"login page layout\">\n    <aside aria-label=\"Identidad de la plataforma\" class=\"identity-panel\" data-kid=\"1-1\" data-name=\"identity panel container\">\n        <div class=\"identity-mobile-title\" data-kid=\"1-1-1\" data-name=\"mobile title container\">\n            <div data-kid=\"1-1-1-1\" data-name=\"mobile title text\">\n                Comprensión lectora\n            </div>\n            <p class=\"identity-note\" data-kid=\"1-1-1-2\" data-name=\"mobile identity note\">\n                Para estudiantes, docentes y familias.\n            </p>\n        </div>\n        <svg aria-labelledby=\"diagram-title diagram-description\" class=\"reading-diagram\" data-kid=\"1-1-2\" data-name=\"reading diagram illustration\" role=\"img\" viewbox=\"0 0 620 470\">\n            <title id=\"diagram-title\">\n                Lectura conectada por una anotación marginal\n            </title>\n            <desc id=\"diagram-description\">\n                Dos bloques abstractos de líneas de lectura están relacionados mediante un corchete y una nota al margen, sin palabras ni personajes.\n            </desc>\n            <g fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <g opacity=\"0.76\" stroke=\"#5b4d65\" stroke-width=\"5\">\n                    <path d=\"M130 96h328\">\n                    </path>\n                    <path d=\"M130 126h278\">\n                    </path>\n                    <path d=\"M130 156h306\">\n                    </path>\n                    <path d=\"M130 186h238\">\n                    </path>\n                    <path d=\"M130 216h292\">\n                    </path>\n                    <path d=\"M130 246h198\">\n                    </path>\n                    <path d=\"M130 312h308\">\n                    </path>\n                    <path d=\"M130 342h262\">\n                    </path>\n                    <path d=\"M130 372h318\">\n                    </path>\n                    <path d=\"M130 402h218\">\n                    </path>\n                </g>\n                <path d=\"M130 282h288\" stroke=\"#7c38a4\" stroke-width=\"6\">\n                </path>\n                <path d=\"M83 255h20c8 0 12 5 12 13v35c0 8 4 13 12 13h20\" stroke=\"#7c38a4\" stroke-width=\"3\">\n                </path>\n                <path d=\"M83 255v-9M83 316v9\" stroke=\"#7c38a4\" stroke-width=\"3\">\n                </path>\n                <path d=\"M147 316c38 0 47-34 80-34\" stroke=\"#7c38a4\" stroke-dasharray=\"2 9\" stroke-width=\"2.5\">\n                </path>\n            </g>\n            <circle cx=\"231\" cy=\"282\" fill=\"#7c38a4\" r=\"6.5\">\n            </circle>\n            <circle cx=\"147\" cy=\"316\" fill=\"#aa3bff\" r=\"4.5\">\n            </circle>\n        </svg>\n        <p class=\"identity-note\" data-kid=\"1-1-3\" data-name=\"desktop identity note\">\n            Para estudiantes, docentes y familias.\n        </p>\n    </aside>\n    <main class=\"access-panel\" data-kid=\"1-2\" data-name=\"access panel container\">\n        <section aria-labelledby=\"login-title\" class=\"access-content\" data-kid=\"1-2-1\" data-name=\"login form section\">\n            <h1 data-kid=\"1-2-1-1\" data-name=\"login section title\" id=\"login-title\">\n                Comprensión lectora\n            </h1>\n            <p class=\"intro\" data-kid=\"1-2-1-2\" data-name=\"login instruction text\">\n                Accede con tu usuario y contraseña\n            </p>\n            <form class=\"login-form\" data-kid=\"1-2-1-3\" data-name=\"login form\">\n                <div class=\"field\" data-kid=\"1-2-1-3-1\" data-name=\"username input field group\">\n                    <label data-kid=\"1-2-1-3-1-1\" data-name=\"username label\" for=\"login-username\">\n                        Usuario\n                    </label>\n                    <input autocomplete=\"username\" data-kid=\"1-2-1-3-1-2\" data-name=\"username input\" id=\"login-username\" name=\"username\" placeholder=\"Escribe tu usuario\" type=\"text\"/>\n                </div>\n                <div class=\"field\" data-kid=\"1-2-1-3-2\" data-name=\"password input field group\">\n                    <label data-kid=\"1-2-1-3-2-1\" data-name=\"password label\" for=\"login-password\">\n                        Contraseña\n                    </label>\n                    <input autocomplete=\"current-password\" data-kid=\"1-2-1-3-2-2\" data-name=\"password input\" id=\"login-password\" name=\"password\" placeholder=\"Escribe tu contraseña\" type=\"password\"/>\n                </div>\n                <div aria-atomic=\"true\" aria-live=\"polite\" class=\"state-slot\" data-dynamic=\"true\" data-kid=\"1-2-1-3-3\" data-name=\"error message container\" data-reason=\"error text injected by validation script\">\n                </div>\n                <button class=\"submit-button\" data-kid=\"1-2-1-3-4\" data-name=\"submit button\" type=\"submit\">\n                    Iniciar sesión\n                </button>\n            </form>\n            <div aria-hidden=\"true\" class=\"bottom-rule\" data-kid=\"1-2-1-4\" data-name=\"decorative horizontal rule\">\n            </div>\n        </section>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-06T08:28:13.419654+00:00",
