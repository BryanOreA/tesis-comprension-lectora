    "var_eb7471716c81": {
      "type": "variant",
      "label": "Login — Reintento claro y compacto",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<main class=\"access-page min-h-[100dvh] bg-white font-sans text-[var(--ink)] antialiased\" data-kid=\"1\" data-name=\"login page container\">\n    <header class=\"access-header\" data-kid=\"1-1\" data-name=\"header section\">\n        <div aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1\" data-name=\"logo container\">\n            <svg data-kid=\"1-1-1-1\" data-name=\"brand logo icon\" focusable=\"false\" role=\"presentation\" viewbox=\"0 0 56 56\">\n                <path d=\"M8 13h28M8 23h18M8 33h23\">\n                </path>\n                <path d=\"M41 13h7v20h-7\">\n                </path>\n            </svg>\n        </div>\n        <p class=\"brand-name\" data-kid=\"1-1-2\" data-name=\"brand name text\">\n            Comprensión lectora\n        </p>\n    </header>\n    <section aria-labelledby=\"login-title\" class=\"access-content\" data-kid=\"1-2\" data-name=\"login form content section\">\n        <h1 data-kid=\"1-2-1\" data-name=\"login form headline\" id=\"login-title\">\n            Iniciar sesión\n        </h1>\n        <form data-kid=\"1-2-2\" data-name=\"login form\" id=\"login-form\" novalidate=\"\">\n            <div class=\"field-group\" data-kid=\"1-2-2-1\" data-name=\"username field group\">\n                <label data-kid=\"1-2-2-1-1\" data-name=\"username label\" for=\"username\">\n                    Usuario\n                </label>\n                <input aria-describedby=\"login-error\" aria-invalid=\"true\" autocomplete=\"username\" class=\"access-input\" data-kid=\"1-2-2-1-2\" data-name=\"username input field\" id=\"username\" name=\"username\" required=\"\" type=\"text\" value=\"lectora_08\"/>\n            </div>\n            <div class=\"field-group\" data-kid=\"1-2-2-2\" data-name=\"password field group\">\n                <label data-kid=\"1-2-2-2-1\" data-name=\"password label\" for=\"password\">\n                    Contraseña\n                </label>\n                <input aria-describedby=\"login-error\" aria-invalid=\"true\" autocomplete=\"current-password\" class=\"access-input\" data-kid=\"1-2-2-2-2\" data-name=\"password input field\" id=\"password\" name=\"password\" required=\"\" type=\"password\" value=\"lectura-y-libros\"/>\n            </div>\n            <div aria-live=\"assertive\" class=\"error-message\" data-dynamic=\"true\" data-kid=\"1-2-2-3\" data-name=\"login error message container\" data-reason=\"visibility toggled by script\" id=\"login-error\" role=\"alert\">\n                <span aria-hidden=\"true\" class=\"error-mark\" data-kid=\"1-2-2-3-1\" data-name=\"error mark icon\">\n                    !\n                </span>\n                <p data-kid=\"1-2-2-3-2\" data-name=\"error message text\">\n                    Usuario o contraseña incorrectos. Revisa los datos e inténtalo de nuevo.\n                </p>\n            </div>\n            <button class=\"submit-button\" data-dynamic=\"true\" data-kid=\"1-2-2-4\" data-name=\"submit button\" data-reason=\"disabled state and text content updated by script during form submission\" id=\"submit-button\" type=\"submit\">\n                <span class=\"button-label\" data-dynamic=\"true\" data-kid=\"1-2-2-4-1\" data-name=\"submit button text\" data-reason=\"text content replaced by script during form submission\">\n                    Iniciar sesión\n                </span>\n            </button>\n            <p aria-live=\"polite\" class=\"pending-message\" data-dynamic=\"true\" data-kid=\"1-2-2-5\" data-name=\"pending feedback message\" data-reason=\"hidden state and inner HTML content updated by script during form submission\" hidden=\"\" id=\"pending-message\" role=\"status\">\n            </p>\n        </form>\n    </section>\n</main>\n<style>\n    .access-page {\n    --ink: #08060d;\n    --body-ink: #514b5a;\n    --line: #e5e4e7;\n    --accent: #aa3bff;\n    --accent-soft: rgba(170, 59, 255, 0.1);\n    --action: #702898;\n    --error: #842d25;\n    --error-bg: #fff5f3;\n    min-height: 100dvh;\n    color: var(--ink);\n    font-family: system-ui, 'Segoe UI', Roboto, sans-serif;\n    padding: 42px clamp(28px, 7vw, 96px) 72px;\n  }\n\n  .access-header {\n    align-items: center;\n    display: flex;\n    gap: 14px;\n    max-width: 1120px;\n    margin-inline: auto;\n  }\n\n  .brand-mark {\n    align-items: center;\n    display: flex;\n    height: 46px;\n    justify-content: center;\n    width: 46px;\n  }\n\n  .brand-mark svg {\n    display: block;\n    height: 42px;\n    width: 42px;\n  }\n\n  .brand-mark path {\n    fill: none;\n    stroke: var(--ink);\n    stroke-linecap: square;\n    stroke-linejoin: miter;\n    stroke-width: 2.6;\n  }\n\n  .brand-name {\n    color: var(--ink);\n    font-size: 17px;\n    font-weight: 640;\n    letter-spacing: -0.25px;\n    line-height: 1.2;\n    margin: 0;\n  }\n\n  .access-content {\n    margin: 78px auto 0;\n    max-width: 1120px;\n  }\n\n  h1 {\n    color: var(--ink);\n    font-size: clamp(36px, 3.25vw, 44px);\n    font-weight: 650;\n    letter-spacing: -1.6px;\n    line-height: 1.08;\n    margin: 0 0 34px;\n  }\n\n  form {\n    max-width: 448px;\n  }\n\n  .field-group {\n    margin-bottom: 22px;\n  }\n\n  label {\n    color: var(--ink);\n    display: block;\n    font-size: 15px;\n    font-weight: 620;\n    letter-spacing: 0;\n    line-height: 1.35;\n    margin-bottom: 9px;\n  }\n\n  .access-input {\n    appearance: none;\n    background: #fff;\n    border: 1px solid #aaa6b0;\n    border-radius: 8px;\n    box-sizing: border-box;\n    color: var(--ink);\n    display: block;\n    font: inherit;\n    font-size: 16px;\n    height: 54px;\n    outline: none;\n    padding: 0 16px;\n    transition: border-color 140ms ease, box-shadow 140ms ease;\n    width: 100%;\n  }\n\n  .access-input[aria-invalid=\"true\"] {\n    border-color: #ad564b;\n  }\n\n  .access-input:focus-visible {\n    border-color: var(--accent);\n    box-shadow: 0 0 0 3px var(--accent-soft);\n  }\n\n  .error-message {\n    align-items: flex-start;\n    background: var(--error-bg);\n    border-radius: 7px;\n    color: var(--error);\n    display: flex;\n    font-size: 14px;\n    gap: 10px;\n    line-height: 1.5;\n    margin: 1px 0 20px;\n    padding: 11px 13px;\n  }\n\n  .error-message p {\n    margin: 0;\n  }\n\n  .error-mark {\n    align-items: center;\n    border: 1.5px solid currentColor;\n    border-radius: 50%;\n    display: inline-flex;\n    flex: 0 0 17px;\n    font-size: 12px;\n    font-weight: 750;\n    height: 17px;\n    justify-content: center;\n    line-height: 1;\n    margin-top: 1px;\n    width: 17px;\n  }\n\n  .submit-button {\n    align-items: center;\n    background: var(--action);\n    border: 0;\n    border-radius: 8px;\n    color: #fff;\n    cursor: pointer;\n    display: flex;\n    font: inherit;\n    font-size: 16px;\n    font-weight: 650;\n    height: 54px;\n    justify-content: center;\n    padding: 0 20px;\n    width: 100%;\n  }\n\n  .submit-button:hover:not(:disabled) {\n    background: #5b1f7d;\n  }\n\n  .submit-button:focus-visible {\n    outline: 3px solid var(--accent);\n    outline-offset: 3px;\n  }\n\n  .submit-button:disabled {\n    background: var(--action);\n    cursor: wait;\n  }\n\n  .button-content {\n    align-items: center;\n    display: inline-flex;\n    gap: 10px;\n    justify-content: center;\n  }\n\n  .pending-message {\n    align-items: center;\n    color: var(--body-ink);\n    display: flex;\n    font-size: 14px;\n    gap: 9px;\n    line-height: 1.4;\n    margin: 13px 0 0;\n  }\n\n  .pending-message[hidden] {\n    display: none;\n  }\n\n  .pending-dot {\n    background: var(--accent);\n    border-radius: 50%;\n    display: inline-block;\n    flex: 0 0 8px;\n    height: 8px;\n    width: 8px;\n  }\n\n  @media (max-width: 640px) {\n    .access-page {\n      padding: 27px 24px 42px;\n    }\n\n    .access-header {\n      gap: 11px;\n    }\n\n    .brand-mark,\n    .brand-mark svg {\n      height: 38px;\n      width: 38px;\n    }\n\n    .brand-name {\n      font-size: 16px;\n    }\n\n    .access-content {\n      margin-top: 57px;\n    }\n\n    h1 {\n      font-size: 36px;\n      letter-spacing: -1.2px;\n      margin-bottom: 29px;\n    }\n\n    form {\n      max-width: none;\n    }\n\n    .field-group {\n      margin-bottom: 19px;\n    }\n\n    .access-input,\n    .submit-button {\n      height: 54px;\n    }\n\n    .error-message {\n      font-size: 14px;\n      margin-bottom: 18px;\n    }\n  }\n\n  @media (max-height: 620px) and (max-width: 640px) {\n    .access-content {\n      margin-top: 32px;\n    }\n\n    .access-page {\n      padding-top: 18px;\n    }\n  }\n</style>\n<script>\n    const form = document.getElementById('login-form');\n  const username = document.getElementById('username');\n  const password = document.getElementById('password');\n  const error = document.getElementById('login-error');\n  const button = document.getElementById('submit-button');\n  const pending = document.getElementById('pending-message');\n\n  const clearError = () => {\n    error.hidden = true;\n    for (const field of [username, password]) {\n      field.setAttribute('aria-invalid', 'false');\n      field.removeAttribute('aria-describedby');\n    }\n  };\n\n  for (const field of [username, password]) {\n    field.addEventListener('input', clearError);\n  }\n\n  form.addEventListener('submit', (event) => {\n    event.preventDefault();\n    clearError();\n    button.disabled = true;\n    button.setAttribute('aria-busy', 'true');\n    button.querySelector('.button-label').textContent = 'Iniciando sesión…';\n    pending.innerHTML = '<span class=\"pending-dot\" aria-hidden=\"true\"></span><span>Comprobando los datos de acceso…</span>';\n    pending.hidden = false;\n\n    window.setTimeout(() => {\n      button.disabled = false;\n      button.removeAttribute('aria-busy');\n      button.querySelector('.button-label').textContent = 'Iniciar sesión';\n      pending.hidden = true;\n      error.hidden = false;\n      for (const field of [username, password]) {\n        field.setAttribute('aria-invalid', 'true');\n        field.setAttribute('aria-describedby', 'login-error');\n      }\n    }, 1050);\n  });\n</script>\n",
      "comments": [],
      "created": "2026-10-06T08:28:06.417582+00:00",
      "modified": "2026-10-06T08:28:25.169645+00:00",
